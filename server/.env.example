# ---------------------------------------------------------------
# Doctor Tracker API - copy to .env and fill in real values.
# Every variable not marked "Optional" is required; the server
# refuses to start if any are missing or invalid.
# ---------------------------------------------------------------

# Port the Express server listens on.
PORT=5000

# Runtime mode: development | production | test
NODE_ENV=development

# MongoDB connection string (local, Docker or Atlas).
MONGODB_URI=mongodb://localhost:27017/doctor-tracker

# Secrets used to sign JWTs. Use long random strings (min 32 chars)
# and different values for each. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-min-32
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-min-32

# Token lifetimes, in jsonwebtoken / ms format (e.g. 15m, 1h, 7d).
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Origin of the Next.js client, used for CORS (no trailing slash).
CLIENT_URL=http://localhost:3000

# Optional. Cookie domain for auth cookies in production
# (e.g. .example.com). Leave empty for localhost.
COOKIE_DOMAIN=

# Optional. Public URL of this API (e.g. https://my-api.onrender.com). In production the server
# calls its own /api/health every 12 minutes so a free hosting tier doesn't put it to sleep.
# Render sets RENDER_EXTERNAL_URL itself, so there it works without this.
KEEP_ALIVE_URL=

# Optional (default 1). How many reverse proxies sit in front of Express and are
# trusted to set X-Forwarded-For; the client IP used for rate limiting is read
# from that many hops back. The Next.js rewrite passes an incoming
# X-Forwarded-For through unchanged, so in production put a proxy that sets it
# (Vercel, nginx, a load balancer) in front of Next.js. Login attempts are also
# limited per account, which doesn't depend on the IP.
TRUST_PROXY=1

# Optional. Used only by `bun run seed`: this is the admin login. The seed creates the user, or
# re-run it after changing the password here to update an existing user (safe to run repeatedly).
SEED_ADMIN_EMAIL=admin@doctortracker.dev
SEED_ADMIN_PASSWORD=change-me-strong-password

# ---------------------------------------------------------------
# Doctor Tracker API - copy to .env and fill in real values.
# Every variable except COOKIE_DOMAIN is required; the server
# refuses to start if any are missing or invalid.
# ---------------------------------------------------------------

# Port the Express server listens on.
PORT=5000

# Runtime mode: development | production | test
NODE_ENV=development

# MongoDB connection string (local, Docker or Atlas).
MONGODB_URI=mongodb://localhost:27017/doctor-tracker

# Secrets used to sign JWTs. Use long random strings (min 32 chars)
# and different values for each. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-min-32
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-min-32

# Token lifetimes, in jsonwebtoken / ms format (e.g. 15m, 1h, 7d).
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Origin of the Next.js client, used for CORS (no trailing slash).
CLIENT_URL=http://localhost:3000

# Optional. Cookie domain for auth cookies in production
# (e.g. .example.com). Leave empty for localhost.
COOKIE_DOMAIN=

# Optional. Used only by `npm run seed` to create the first admin user.
# The seed is idempotent: an existing user with this email is left untouched.
SEED_ADMIN_EMAIL=admin@doctortracker.dev
SEED_ADMIN_PASSWORD=change-me-strong-password
